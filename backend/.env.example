# Proposed names; backend must implement and document configuration loading.
DATABASE_URL=postgresql+asyncpg://local_user:local_password@localhost:5432/naukma_vote
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Required for issuing tokens: generate a random secret with at least 32 bytes.
SESSION_SECRET=
ACCESS_EXPIRES_SECONDS=900
REFRESH_EXPIRES_SECONDS=2592000
# Local-only example database credentials above; never use them on staging.

# --- Elections & Voting Core (реалізовано в backend/app/core/config.py) ---
# local | staging | production. У production застосунок не стартує з небезпечною конфігурацією.
APP_ENV=local
# Дозволяє лише окремий тестовий /api/auth/login; X-User-Id не авторизує API.
# Для staging і production задавати false. Локально можна явно увімкнути для тестів.
ALLOW_MOCK_AUTH=false
# Таймер закриття голосувань за ends_at
ELECTION_CLOSER_ENABLED=true
ELECTION_CLOSER_INTERVAL_SECONDS=5
# Домен whitelist і Google Workspace: OAuth перевіряє email + hd.
# Для університетського входу не залишати порожнім.
ALLOWED_EMAIL_DOMAIN=ukma.edu.ua
# Для CORS у production: один або кілька https-адрес через кому
# FRONTEND_ORIGIN=https://vote.example.edu.ua

# Лише для backend/tests/test_pg_concurrency.py. БД буде очищена! Ім'я має містити "test".
# TEST_DATABASE_URL=postgresql+asyncpg://local_user:local_password@localhost:5432/naukma_vote_test
# Session cookies: local defaults to Lax without Secure; staging/production default
# to SameSite=None with Secure for separate sites. OAuth state always uses Lax.
# Set lax when deploying frontend/API under the same site; None requires HTTPS.
# SESSION_COOKIE_SAMESITE=lax
